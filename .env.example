# Copy to .env and fill in. Never commit the real .env.

# Want to look around first? You do not need this file at all — see "Prova på"
# in the README, or just run:  docker compose -f docker-compose.demo.yml up

# --- Required ---------------------------------------------------------------

# The one password everyone in the house shares. Anything without it is locked.
BOOKING_PASSWORD=byt-mig-till-nagot-langt

# The public address, used in e-mails and calendar links. Must be the real URL
# or the links in confirmation e-mails will point somewhere useless.
BASE_URL=https://booking.rudbeckia.nu

# --- Optional ---------------------------------------------------------------

# A second password that also unlocks /admin, where every booking is listed.
# Leave empty to turn the admin view off entirely.
ADMIN_PASSWORD=

# Signs session cookies. If empty it is derived from the passwords above, which
# means changing a password logs everyone out. Set it to keep sessions alive.
SESSION_SECRET=

# How long a login lasts.
SESSION_DAYS=30

# debug, info, warn or error.
LOG_LEVEL=info

# --- Outgoing mail ----------------------------------------------------------
# Leave SMTP_HOST empty to run without e-mail: bookings still work, and the
# confirmation is written to the log instead of being sent.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bokning@rudbeckia.nu
SMTP_FROM_NAME=Rudbeckia bokning
# starttls (port 587), tls (port 465) or none.
SMTP_ENCRYPTION=starttls
# Where replies to the confirmation go.
SMTP_REPLY_TO=
# Optional blind copy of every notification, e.g. an archive address.
SMTP_BCC=
