# Copy to .env and fill in. Never commit the real .env.

# Want to look around first? You do not need this file at all — see "Prova på"
# in the README, or just run:  docker compose -f docker-compose.demo.yml up

# --- Required ---------------------------------------------------------------

# The one password everyone in the house shares. Anything without it is locked.
BOOKING_PASSWORD=byt-mig-till-nagot-langt

# The public address, used in the bot's messages and calendar links. Must be
# the real URL or the links in the confirmations will point somewhere useless.
BASE_URL=https://booking.rudbeckia.nu

# --- Optional ---------------------------------------------------------------

# A second password that also unlocks /admin, where every booking is listed.
# Leave empty to turn the admin view off entirely.
ADMIN_PASSWORD=

# Signs session cookies. If empty it is derived from the passwords above, which
# means changing a password logs everyone out. Set it to keep sessions alive.
SESSION_SECRET=

# How long a login lasts.
SESSION_DAYS=30

# debug, info, warn or error.
LOG_LEVEL=info

# --- Mattermost -------------------------------------------------------------
# The bot that sends confirmations and looks up who is booking. Leave both
# empty to run without a chat server: bookings still work, the username is
# taken as typed, and the confirmation is written to the log instead.
# Set both or neither — half a configuration is refused at startup.

MATTERMOST_URL=https://chat.rudbeckia.nu
MATTERMOST_TOKEN=

# Comma-separated Mattermost usernames that may book. Empty means everyone in
# the directory may. Useful while the house is trying the bot out.
MATTERMOST_ALLOW=
